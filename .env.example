# --- Base de données (PostgreSQL) ---
# Local : docker compose up -d  (Postgres exposé sur 54329)
# Vercel/Neon : utiliser l'URL "pooled" (pgbouncer) pour DATABASE_URL.
DATABASE_URL=postgres://mitc:mitc@localhost:54329/mitc_dev

# --- URL publique de l'application (liens dans les e-mails, redirection Entra) ---
APP_URL=http://localhost:3000

# --- Secrets (générer avec : openssl rand -base64 32) ---
# Signature des cookies de session (Better Auth)
BETTER_AUTH_SECRET=
# Clé maître de chiffrement des secrets stockés en base (32 octets en base64)
SETTINGS_ENCRYPTION_KEY=

# --- Premier démarrage (facultatif) ---
# Jeton d'installation fourni par variable d'environnement (sinon : pnpm setup:admin)
SETUP_TOKEN=

# --- Développement uniquement : capture locale des e-mails si aucun SMTP n'est configuré ---
# Ignoré en production.
DEV_MAIL_CAPTURE_URL=smtp://localhost:11025

# --- Travaux différés (Vercel Cron) ---
CRON_SECRET=
